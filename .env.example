# Plantilla de variables. Copiar a `.env` y completar.
# `.env` está en `.gitignore`: nunca se commitea.
#
# Las claves locales las imprime `supabase status`. Las de producción se sacan
# del dashboard del proyecto remoto y solo viven en el gestor de secretos y en
# el entorno de la Edge Function. Ver `docs/SUPABASE_REMOTO.md`.

# --- Local -------------------------------------------------------------------

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar
SUPABASE_SERVICE_ROLE_KEY=sb_secret_reemplazar

# Secreto compartido entre el job de pg_cron y la Edge Function.
# La función lo compara con `x-collector-secret`; no es un JWT.
COLLECTOR_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# --- Remoto (completar al crear el proyecto) ---------------------------------

# Referencia del proyecto: https://supabase.com/dashboard/project/<ref>
# SUPABASE_PROJECT_REF=
# Token personal de la CLI: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
